<!-- Hero Section -->
<section class="hero-section">
  <div class="container">
    <div class="hero-content">
      <h1>Bringing Nature Closer to You</h1>
      <p>Discover a premium collection of plants, seeds, and gardening essentials to transform your space into a green
        sanctuary</p>
      <a href="/shop" class="btn-primary-custom">Start Shopping</a>
    </div>
  </div>
</section>

<!-- Categories Section -->
<section class="section">
  <div class="container">
    <h2 class="section-heading">Shop by Category</h2>
    <p class="section-subtitle">Explore our diverse collection of plants</p>

    <div class="row g-4">
      <div class="col-md-6 col-lg-3">
        <div class="category-card">
          <div class="category-icon">🌸</div>
          <h3>Flowering Plants</h3>
          <p>Colorful blooms to brighten any space</p>
        </div>
      </div>
      <div class="col-md-6 col-lg-3">
        <div class="category-card">
          <div class="category-icon">🌴</div>
          <h3>Indoor Plants</h3>
          <p>Perfect for home and office decor</p>
        </div>
      </div>
      <div class="col-md-6 col-lg-3">
        <div class="category-card">
          <div class="category-icon">🌵</div>
          <h3>Succulents</h3>
          <p>Low-maintenance hardy plants</p>
        </div>
      </div>
      <div class="col-md-6 col-lg-3">
        <div class="category-card">
          <div class="category-icon">🌿</div>
          <h3>Outdoor Plants</h3>
          <p>Create your dream garden</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Featured Products -->
<section class="section bg-light">
  <div class="container">
    <h2 class="section-heading">Featured Products</h2>
    <p class="section-subtitle">Hand-picked selections from our collection</p>

    <div class="row g-4">
      {{#each homeProducts}}
      <div class="col-md-6 col-lg-3">
        <div class="product-card">
          <div class="product-image-wrapper">
            <img src="{{imagePath this.thumbnailPaths.[0]}}" alt="{{this.productName}}">
            {{#if this.discount}}<div class="product-badge">-{{this.discount}}%</div>{{/if}}
            <div class="product-actions">
              <button class="action-btn" title="Add to Wishlist" onclick="addToWishlist('{{this._id}}')">
                <i class="fas fa-heart"></i>
              </button>
              <a href="/productDetails/{{this._id}}" class="action-btn" title="View Details">
                <i class="fas fa-eye"></i>
              </a>
              <button class="action-btn add-to-cart-btn" data-id="{{this._id}}" title="Add to Cart">
                <i class="fas fa-shopping-cart"></i>
              </button>
            </div>
          </div>
          <div class="product-info">
            <span class="product-category">{{this.category}}</span>
            <h5 class="product-name">{{this.productName}}</h5>
            <div class="product-rating">
              <i class="fas fa-star"></i>
              <i class="fas fa-star"></i>
              <i class="fas fa-star"></i>
              <i class="fas fa-star"></i>
              <i class="fas fa-star-half-alt"></i>
              <span>(4.5)</span>
            </div>
            <div class="product-price">
              <span class="product-price-new">₹{{this.price}}</span>
              {{#if this.originalPrice}}<span class="product-price-old">₹{{this.originalPrice}}</span>{{/if}}
            </div>
          </div>
        </div>
      </div>
      {{/each}}
    </div>

    <div class="text-center mt-5">
      <a href="/shop" class="btn-primary-custom">View All Products</a>
    </div>
  </div>
</section>

<!-- Benefits Section -->
<section class="section">
  <div class="container">
    <div class="row g-4">
      <div class="col-md-3 text-center">
        <div style="font-size: 2.5rem; color: var(--accent-green); margin-bottom: 1rem;">
          <i class="fas fa-truck"></i>
        </div>
        <h5>Free Shipping</h5>
        <p>On orders above ₹500</p>
      </div>
      <div class="col-md-3 text-center">
        <div style="font-size: 2.5rem; color: var(--accent-green); margin-bottom: 1rem;">
          <i class="fas fa-shield-alt"></i>
        </div>
        <h5>100% Secure</h5>
        <p>Safe transactions guaranteed</p>
      </div>
      <div class="col-md-3 text-center">
        <div style="font-size: 2.5rem; color: var(--accent-green); margin-bottom: 1rem;">
          <i class="fas fa-undo"></i>
        </div>
        <h5>Easy Returns</h5>
        <p>30-day return policy</p>
      </div>
      <div class="col-md-3 text-center">
        <div style="font-size: 2.5rem; color: var(--accent-green); margin-bottom: 1rem;">
          <i class="fas fa-headset"></i>
        </div>
        <h5>Support 24/7</h5>
        <p>Dedicated customer service</p>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
    btn.addEventListener('click', function (e) {
      e.preventDefault();
      const productId = this.dataset.id;
      // Add to cart logic here
      fetch('/addToCart', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ productId: productId, quantity: 1 })
      })
        .then(res => res.json())
        .then(data => {
          if (data.message.includes("success") || data.cart) {
            openCartDrawer();
          } else {
            Swal.fire({
              icon: 'error',
              title: 'Oops...',
              text: data.message || 'Could not add product to cart',
            });
          }
        })
        .catch(err => console.log(err));
    });
  });

  function addToWishlist(productId) {
    fetch('/addToWishlist', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({ productId: productId })
    })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          Swal.fire('Added to Wishlist!', '', 'success');
        }
      })
      .catch(err => console.log(err));
  }
</script>